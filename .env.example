FUNCTIONS_ENDPOINT_URL=  # firebase functions url (Firebase emulator or production Cloud Run URL)

# Deployment variables (used by deploy_cloud_run.sh)
# For local development and dev deploys, put values in `.env`.
# For production Cloud Run deploys, put values in `.env.production` and keep it out of source control.
# PROJECT_ID: GCP project id
# REGION: Cloud Run region (e.g. europe-west6)
# SERVICE_NAME: Cloud Run service name
# IMAGE_NAME: Container image name (default is same as service)
# ALLOW_UNAUTH: true|false — whether to allow unauthenticated access
PROJECT_ID=
REGION=
SERVICE_NAME=
IMAGE_NAME=
ALLOW_UNAUTH=